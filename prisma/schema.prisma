generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SchoolType {
  id         Int    @id @default(autoincrement())
  schoolType String @map("school_type")

  moes MOE[]

  @@map("SchoolType")
}

model AllowedSchoolLevel {
  id          Int    @id @default(autoincrement())
  schoolLevel String @map("school_level")

  moes MOE[]

  @@map("AllowedSchoolLevel")
}

model ClassToBeTaught {
  id              Int    @id @default(autoincrement())
  classToBeTaught String @map("class_to_be_taught")

  moes MOE[]

  @@map("ClassToBeTaught")
}

model MOE {
  id                   Int      @id @default(autoincrement())
  schoolName           String   @map("school_name")
  schoolAddress        String?  @map("school_address")
  openingPeriod        String?  @map("opening_period")

  schoolTypeId         Int?     @map("school_type_id")
  allowedSchoolLevelId Int?     @map("allowed_school_level_id")
  classToBeTaughtId    Int?     @map("class_to_be_taught_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  schoolType         SchoolType?         @relation(fields: [schoolTypeId], references: [id])
  allowedSchoolLevel AllowedSchoolLevel? @relation(fields: [allowedSchoolLevelId], references: [id])
  classToBeTaught    ClassToBeTaught?    @relation(fields: [classToBeTaughtId], references: [id])

  @@map("MOE")
}